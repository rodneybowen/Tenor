# Copy to `.env.local` (gitignored) and fill in real values from your
# Supabase project (Project Settings → API).
#
# The anon key is safe to ship to the browser — it lets clients hit
# Supabase, but every table has RLS so they can only read/write rows
# the policies allow. NEVER put the service_role key in a Vite env
# var (it bypasses RLS — server-side only).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE

# VAPID public key for Web Push subscriptions (Phase 3 of the
# Reminder System). Safe to ship to the browser — it's the public
# half of an asymmetric pair. The PRIVATE half lives only as a
# Supabase Edge Function secret named VAPID_PRIVATE_KEY.
# Generate a pair with `web-push generateVAPIDKeys` or the
# `web-push` npm module. The shipped value below is the pair we
# generated on 2026-06-12 — rotate by replacing both halves.
VITE_VAPID_PUBLIC_KEY=BD0h6gQPBbeMqjpKo94lG1x4uBrS8_3cZjNtQzpbe5LcHh08szVS0hYRbEj1NkUeJz1UZMVHJLvaNGcvtPwjHlk
